-- Generated by `phi theme` — do not edit by hand.
--
-- phiOS colour overlay for Neovim's built-in highlight groups (S-51;
-- OOP-14 expansion). Deliberately only the stable, always-present groups
-- of `:h highlight-groups` and `:h diagnostic-highlights` — no plugin or
-- Tree-sitter groups, which vary by setup and are a later pass. Applied on
-- top of whatever base colorscheme is active, so it never has to be
-- complete: it pulls the editor onto the phi palette and leaves the rest.

local hl = function(group, opts) vim.api.nvim_set_hl(0, group, opts) end

-- Structure -----------------------------------------------------------------
hl("Normal",        { bg = "${PHI_BG_0}", fg = "${PHI_FG_0}" })
