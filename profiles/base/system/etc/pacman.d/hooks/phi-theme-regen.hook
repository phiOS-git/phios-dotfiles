# phiOS pacman hook to regenerate themed configs after package upgrade.
# /etc material, NEVER applied by phios-install — copy to /etc/pacman.d/hooks/
# manually after reading.
#
# Targets packages whose upgrade could put stale config back: GTK/Qt packages,
# kitty, phi, phi-shell. Upgrades to phi can change template contract.
#
# `Exec` cannot be an inline shell command — pacman's hook format takes a
# single executable path only — so logic lives in /usr/local/bin/
# phi-theme-regen-hook.sh (also /etc material, also never applied
# automatically). Both files unverified: no real pacman transaction has run
# them yet.

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = kitty
Target = gtk3
Target = gtk4
Target = qt5ct
Target = qt6ct
Target = phi
Target = phi-shell

[Action]
Description = phiOS: regenerate themed configs for the logged-in user
When = PostTransaction
Exec = /usr/local/bin/phi-theme-regen-hook.sh
