# Server list for the [phi] own-package repository, served by mini's
# darkhttpd over the overlay network. Included from /etc/pacman.conf by the
# [phi] section (documented in profiles/base/manual.txt); pacman.conf itself
# has no drop-in mechanism, so that stanza is applied by hand.
#
# <mini-overlay-address> and <port> are machine data (no IP address or
# overlay hostname in any repository) and are never filled in here. Replace
# both by hand before this file resolves to anything.
Server = http://<mini-overlay-address>:<port>/
