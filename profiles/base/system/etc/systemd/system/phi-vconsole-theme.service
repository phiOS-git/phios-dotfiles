# phiOS design-token palette for Linux virtual terminals. phiOS runs no
# display manager — login is agetty on VT, themed by /etc/issue (static mark)
# and this unit which repaints the 16 VT palette entries from
# design/tokens.dark.sh PHI_ANSI_* tokens. Result: login prompt, input, and
# console messages in phiOS palette instead of stock VGA.
#
# DECLARED, NEVER ENABLED by the installer. profiles/base/system/ is shown
# by --system-diff and applied by hand. Enable with:
#   sudo systemctl enable phi-vconsole-theme.service
#
# /etc/phi/console.palette uses literal 0-255 decimals (setvtrgb's format),
# not template substitution. Manual re-sync needed on palette changes.
# Provenance (dark variant, tokens.dark.sh hex → decimal, ANSI 0-15):
#   0 #242320   1 #b57b73   2 #8fa77e   3 #c0a874
#   4 #7f95ab   5 #d3a0ac   6 #3d9e9e   7 #d6d1c9
#   8 #878279   9 #d7897f  10 #87a76f  11 #bd9d53
#  12 #809ebd  13 #d292a2  14 #1eaaab  15 #d6d1c9
#
# Revert on running system: setvtrgb vga

[Unit]
Description=phiOS console palette (design tokens applied to the Linux VT colours)
Documentation=man:setvtrgb(8)
After=systemd-vconsole-setup.service
Before=getty.target systemd-user-sessions.service
ConditionPathExists=/etc/phi/console.palette
ConditionPathExists=/usr/bin/setvtrgb

[Service]
Type=oneshot
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty0
ExecStart=/usr/bin/setvtrgb /etc/phi/console.palette

[Install]
WantedBy=multi-user.target
