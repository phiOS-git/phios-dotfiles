pragma Singleton
import Quickshell

// phiOS — STRUCTURAL design tokens (radius, spacing, motion, fonts, z-layers,
// texture catalogue). Generated by `phi theme set` from design/tokens.common.sh
// via design/adapters.txt. GENERATED: never edit by hand — edit the token
// files and re-run `phi theme set` to regenerate.
//
// Tokens here are identical across dark/light variants (colour differs and
// now lives in Config/Colors.json, read by Config/Colors.qml). Because this
// file's source doesn't change on variant switch (only Colors.json does),
// Quickshell never re-evaluates this singleton on switch — avoiding a forced
// re-evaluation that used to reset in-flight panel/session state.
//
// Every value is a string with units included ("14px", "120ms", "1ch"),
// per design/tokens.common.sh contract. Consumers strip the unit if needed.
// Only phi-shell's Config/Appearance.qml reads these; everything else reads
// Appearance.

Singleton {
    id: root

    // --- Typography --------------------------------------------------------
    readonly property string fontMono: "${PHI_FONT_MONO}"
    readonly property string fontReading: "${PHI_FONT_READING}"
    readonly property string fontUi: "${PHI_FONT_UI}"
    readonly property string fontSymbol: "${PHI_FONT_SYMBOL}"

    // --- Size scale --------------------------------------------------------
    readonly property string fontSize0: "${PHI_FONT_SIZE_0}"
    readonly property string fontSize1: "${PHI_FONT_SIZE_1}"
    readonly property string fontSize2: "${PHI_FONT_SIZE_2}"
    readonly property string fontSize3: "${PHI_FONT_SIZE_3}"
    readonly property string fontSize4: "${PHI_FONT_SIZE_4}"
    readonly property string fontSize5: "${PHI_FONT_SIZE_5}"
    readonly property string fontSize6: "${PHI_FONT_SIZE_6}"

    // --- Spacing -------------------------------------------------------
    readonly property string space1: "${PHI_SPACE_1}"
    readonly property string space2: "${PHI_SPACE_2}"
    readonly property string space3: "${PHI_SPACE_3}"
    readonly property string space4: "${PHI_SPACE_4}"
    readonly property string space5: "${PHI_SPACE_5}"
    readonly property string space6: "${PHI_SPACE_6}"

    // --- Shape -------------------------------------------------------
    readonly property string radiusBase: "${PHI_RADIUS_BASE}"
    readonly property string radiusPill: "${PHI_RADIUS_PILL}"
    readonly property string radiusSmall: "${PHI_RADIUS_SMALL}"
    readonly property string radiusLarge: "${PHI_RADIUS_LARGE}"
    readonly property string borderWidth: "${PHI_BORDER_WIDTH}"
    readonly property string borderWidthStrong: "${PHI_BORDER_WIDTH_STRONG}"
    readonly property string panelPadding: "${PHI_PANEL_PADDING}"
    readonly property string panelGap: "${PHI_PANEL_GAP}"
    readonly property string panelRadius: "${PHI_PANEL_RADIUS}"
    readonly property string sliderThickness: "${PHI_SLIDER_THICKNESS}"

    // --- User-tunable scale (identity by default) --------------------------
    readonly property string fontScale: "${PHI_FONT_SCALE}"
    readonly property string spaceScale: "${PHI_SPACE_SCALE}"

    // --- Layering -------------------------------------------------------
    readonly property string zBase: "${PHI_Z_BASE}"
    readonly property string zBar: "${PHI_Z_BAR}"
    readonly property string zPopover: "${PHI_Z_POPOVER}"
    readonly property string zModal: "${PHI_Z_MODAL}"
    readonly property string zTooltip: "${PHI_Z_TOOLTIP}"
    readonly property string zNotification: "${PHI_Z_NOTIFICATION}"

    // --- Motion -------------------------------------------------------
    readonly property string motionAPeriod: "${PHI_MOTION_A_PERIOD}"
    readonly property string motionAEasing: "${PHI_MOTION_A_EASING}"
    readonly property string motionBDuration: "${PHI_MOTION_B_DURATION}"
    readonly property string motionBEasing: "${PHI_MOTION_B_EASING}"
    readonly property string motionBBezier: "${PHI_MOTION_B_BEZIER}"
    readonly property string motionCTypeStep: "${PHI_MOTION_C_TYPE_STEP}"
    readonly property string motionCScramble: "${PHI_MOTION_C_SCRAMBLE}"
    readonly property string motionCEasing: "${PHI_MOTION_C_EASING}"
    readonly property string motionDDuration: "${PHI_MOTION_D_DURATION}"

    // --- Wallpaper texture catalogue (Out-of-plan: settings-overhaul) -----
    readonly property string textureModes: "${PHI_TEXTURE_MODES}"
    readonly property string textureIntensityDefault: "${PHI_TEXTURE_INTENSITY_DEFAULT}"
}
