# phiOS — kitty font configuration.
#
# Separate from theme.conf.tmpl (colours) on purpose: this file changes only
# when a font token changes, not on every `phi theme set`. Font edits never
# touch colour-only diffs or vice versa.
#
# Fallback chain, generated from tokens rather than hand-written:
#   1. font-mono (primary)
#   2. font-symbol (glyphs only, Nerd Fonts)
#   3. targeted Noto (Greek + extended Latin, via fontconfig/fonts.conf.tmpl)
#
# symbol_map is critical: kitty does NOT rely on fontconfig alone for
# missing glyphs. The codepoints below are Private Use Area. Without explicit
# symbol_map, kitty renders them as boxes. Ranges are from Nerd Fonts v3.5.0
# glyph-set table: Pomicons, Powerline, Font Awesome, Devicons, Codicons,
# Material Design Icons, and others. This is what yazi and other Nerd-Font
# TUIs need to render correctly.
font_family      ${PHI_FONT_MONO}

symbol_map U+E000-U+E00A ${PHI_FONT_SYMBOL}
symbol_map U+E0A0-U+E0A2,U+E0B0-U+E0B3 ${PHI_FONT_SYMBOL}
symbol_map U+E0A3,U+E0B4-U+E0C8,U+E0CA,U+E0CC-U+E0D7,U+2630 ${PHI_FONT_SYMBOL}
symbol_map U+E200-U+E2A9 ${PHI_FONT_SYMBOL}
symbol_map U+E300-U+E3E3 ${PHI_FONT_SYMBOL}
symbol_map U+E5FA-U+E6BB ${PHI_FONT_SYMBOL}
symbol_map U+E700-U+E958 ${PHI_FONT_SYMBOL}
symbol_map U+EA60-U+EC84 ${PHI_FONT_SYMBOL}
symbol_map U+ED00-U+F2FF ${PHI_FONT_SYMBOL}
symbol_map U+F300-U+F384 ${PHI_FONT_SYMBOL}
symbol_map U+F400-U+F533,U+2665,U+26A1 ${PHI_FONT_SYMBOL}
symbol_map U+23FB-U+23FE,U+2B58 ${PHI_FONT_SYMBOL}
symbol_map U+F0001-U+F1AF0 ${PHI_FONT_SYMBOL}
