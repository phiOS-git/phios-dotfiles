# phiOS — GTK3 settings (S-41). gtk-application-prefer-dark-theme is the
# fallback for a GTK3 app that reads this file directly instead of the
# portal's org.gnome.desktop.interface color-scheme (phi theme set writes
# both, in internal/theme/set.go's setPortalPreference — this file is the
# static, restart-required half; the portal write is the live half).
# gtk-decoration-layout empty suppresses the header-bar's own min/max/close
# buttons (Q-N05: CSD suppressed — decided this session). This alone does
# NOT remove client-side decoration for a libadwaita/GTK4 app that hardcodes
# its own HeaderBar as content — see profiles/desktop/home/.config/hypr/
# hyprland.lua's GTK_CSD=0 (hl.env(), ENVIRONMENT section) and its own note
# on that limit.
#
# Class C, same reasoning as gtk.css.tmpl in this same directory.

[Settings]
gtk-application-prefer-dark-theme=${PHI_VARIANT_IS_DARK}
gtk-decoration-layout=

