# phiOS — GTK3 settings.
#
# gtk-application-prefer-dark-theme: fallback for GTK3 apps that read this
# file directly instead of org.gnome.desktop.interface color-scheme portal.
#
# gtk-decoration-layout: empty suppresses header-bar's min/max/close buttons.
# Does NOT remove client-side decoration in libadwaita/GTK4 apps that
# hardcode HeaderBar — see hyprland.lua.tmpl's GTK_CSD=0 environment setting.
#
# gtk-cursor-theme-name/-size: redundant with XCURSOR_THEME/XCURSOR_SIZE
# env vars (set in hyprland.lua.tmpl), but kept in case GTK app resolves
# its cursor theme before those env vars are visible.
#
# Class C (no runtime reload, requires restart).

[Settings]
gtk-application-prefer-dark-theme=${PHI_VARIANT_IS_DARK}
gtk-decoration-layout=
gtk-cursor-theme-name=${PHI_CURSOR_THEME}
gtk-cursor-theme-size=${PHI_CURSOR_SIZE}

