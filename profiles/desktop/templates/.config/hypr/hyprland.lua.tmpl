-- Cursor spotlight: press Super twice and hold; releasing Super hides it. The
-- shell times the double press. Both binds pass the key through, so every
-- Super combination keeps working. Super is still in the modifier mask when its
-- own key is released, hence SUPER on the release bind.
hl.bind("SUPER_L", hl.dsp.exec_cmd(qsIpc("spotlight", "superDown")), { non_consuming = true },
    { description = "Cursor spotlight (double-press Super and hold)" })
hl.bind("SUPER + SUPER_L", hl.dsp.exec_cmd(qsIpc("spotlight", "superUp")), { release = true, non_consuming = true })

