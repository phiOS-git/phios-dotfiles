local mainMod = "SUPER"

hl.bind(mainMod .. " + M", hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"))

-- apps
hl.bind(mainMod .. " + Return", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + B", hl.dsp.exec_cmd(browser))
hl.bind(mainMod .. " + E", hl.dsp.exec_cmd(fileManager))

-- windows managing
hl.bind(mainMod .. " + Q", hl.dsp.window.close(), { description = "Close the active window" })
hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left" }),  { description = "Focus the window to the left" })
hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }), { description = "Focus the window to the right" })
hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up" }),    { description = "Focus the window above" })
hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down" }),  { description = "Focus the window below" })

-- The core window-manager bindings that were never written (only the five
-- above and the Super+Return/B/E app launchers existed before). "Super for
-- the window manager" (master plan §8.2 S-38) — so every one of these is
-- Super, or Super+Shift for the "move / send" variant, mirroring the
-- universal tiling-WM convention and Hyprland's own example/hyprland.lua.
--
-- API forms confirmed against hyprwm/Hyprland's example/hyprland.lua this
-- session and used natively below: `hl.dsp.focus({ workspace = N })`,
-- `hl.dsp.window.move({ workspace = N })`, `hl.dsp.window.float({ action =
-- "toggle" })`, `hl.dsp.layout("togglesplit")`,
-- `hl.dsp.workspace.toggle_special(name)`, and the `mouse:272/273` +
-- `{ mouse = true }` drag/resize pair.
--
-- Super+wheel is NOT bound to workspace scroll here — the OOP-50 magnifier
-- (further down) owns Super+wheel for its zoom, and would silently win the
-- collision anyway (last bind for a key combo wins). Workspace switching is
-- Super+1..0 for a specific one and Super+Ctrl+left/right for
-- previous/next (Super+arrows on their own move window FOCUS, not the
-- workspace).
--
-- Everything the example did NOT show — direction-based window moves,
-- centre/pin, per-key resize, monitor focus/move, fullscreen — goes through
-- `hl.dsp.exec_cmd("hyprctl dispatch ...")` on purpose: `hyprctl dispatch`
-- is a stable interface, and a wrong `hl.dsp.*` shape can abort the whole
-- Lua script on load (taking out every bind, not just the bad one). Once
-- the native forms are confirmed on real hardware these can move over. C-06.

-- move the active window in a direction (opposite of the focus binds above)
hl.bind(mainMod .. " + SHIFT + left",  hl.dsp.exec_cmd("hyprctl dispatch movewindow l"), { description = "Move the window left" })
hl.bind(mainMod .. " + SHIFT + right", hl.dsp.exec_cmd("hyprctl dispatch movewindow r"), { description = "Move the window right" })
hl.bind(mainMod .. " + SHIFT + up",    hl.dsp.exec_cmd("hyprctl dispatch movewindow u"), { description = "Move the window up" })
hl.bind(mainMod .. " + SHIFT + down",  hl.dsp.exec_cmd("hyprctl dispatch movewindow d"), { description = "Move the window down" })

-- docs/TODO.md: "super+shit+left/right do not change active workspace" —
-- on the real hardware this was reported from, EVERY Super+[extra
-- modifier]+arrow combo (this block, and the workspace prev/next block
-- below) does nothing at all, while the plain two-key Super+arrow focus
-- binds above work fine. Checked three real, separate places this could
-- break, against hyprwm/Hyprland's own source rather than guessing: the
-- bind string shape (`"SUPER + SHIFT + left"`, confirmed identical to
-- Hyprland's own example/hyprland.lua), the modifier token table
-- (`src/keybinds/Resolver.cpp`'s `MODIFIER_NAMES` — both "SHIFT" and
-- "CTRL" are real, recognized names, not typos), and keycode resolution
-- (`CResolver::resolveKeycode`, which resolves "left"/"right" the same
-- way regardless of which modifier accompanies them). All three check
-- out; no config-level defect found. Added as h/j/k/l ALTERNATIVES,
-- alongside the arrow binds rather than replacing them, on the theory
-- that whatever is actually wrong is specific to the arrow keys
-- themselves on this hardware/layout, not to 3-key chords in general —
-- other Super+Shift+<letter> binds elsewhere in this file (F, C, P) were
-- not reported as broken. h/j/k/l already means left/down/up/right
-- elsewhere in this exact file (the RESIZE submap below).
hl.bind(mainMod .. " + SHIFT + h", hl.dsp.exec_cmd("hyprctl dispatch movewindow l"), { description = "Move the window left" })
hl.bind(mainMod .. " + SHIFT + l", hl.dsp.exec_cmd("hyprctl dispatch movewindow r"), { description = "Move the window right" })
hl.bind(mainMod .. " + SHIFT + k", hl.dsp.exec_cmd("hyprctl dispatch movewindow u"), { description = "Move the window up" })
hl.bind(mainMod .. " + SHIFT + j", hl.dsp.exec_cmd("hyprctl dispatch movewindow d"), { description = "Move the window down" })

-- layout / floating state
hl.bind(mainMod .. " + F",         hl.dsp.exec_cmd("hyprctl dispatch fullscreen 0"), { description = "Toggle fullscreen" })
hl.bind(mainMod .. " + SHIFT + F", hl.dsp.window.float({ action = "toggle" }), { description = "Toggle floating" })
hl.bind(mainMod .. " + J",         hl.dsp.layout("togglesplit"), { description = "Toggle the dwindle split direction" })
-- Centre-window is on Super+Shift+C, not Super+C: Super+C is deliberately
-- left unbound here so it reaches the focused application — kitty maps it
-- to copy-to-clipboard (kitty.conf). A bare Super+C bind would be consumed
-- by the compositor before the terminal ever saw it.
hl.bind(mainMod .. " + SHIFT + C", hl.dsp.exec_cmd("hyprctl dispatch centerwindow"), { description = "Centre the floating window" })
hl.bind(mainMod .. " + SHIFT + P", hl.dsp.exec_cmd("hyprctl dispatch pin"), { description = "Pin the floating window to every workspace" })

-- numbered workspaces (Super+1..0), and send-to-workspace (Super+Shift+1..0).
-- Loop taken verbatim from example/hyprland.lua, including `i % 10` mapping
-- workspace 10 onto the "0" key.
for i = 1, 10 do
    local key = i % 10
    hl.bind(mainMod .. " + " .. key,         hl.dsp.focus({ workspace = i }),       { description = "Go to workspace " .. i })
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }), { description = "Send the window to workspace " .. i })
end

-- Previous / next workspace on the focused monitor (user request). The
-- keyboard companion to the numbered binds above and to the three-finger
-- swipe in the GESTURES section — all three use `workspace m-1 / m+1`,
-- which is MONITOR-relative: it cycles the workspaces this monitor
-- actually has and wraps, never spawning an empty one. Super+Ctrl+arrows
-- is the GNOME/KDE convention for this and was unbound. `hyprctl dispatch`
-- rather than a native `hl.dsp.*` form for the same reason as the
-- direction moves above (C-06: an unconfirmed Lua shape can abort the
-- whole script; `hyprctl dispatch workspace` is a stable interface).
hl.bind(mainMod .. " + CTRL + left",  hl.dsp.exec_cmd("hyprctl dispatch workspace m-1"), { description = "Previous workspace" })
hl.bind(mainMod .. " + CTRL + right", hl.dsp.exec_cmd("hyprctl dispatch workspace m+1"), { description = "Next workspace" })
-- docs/TODO.md: h/j/k/l alternatives for the same reason as the move-
-- window block above — see that block's own comment for the
-- investigation. h/l match this file's own left/right convention
-- (RESIZE submap below).
hl.bind(mainMod .. " + CTRL + h", hl.dsp.exec_cmd("hyprctl dispatch workspace m-1"), { description = "Previous workspace" })
hl.bind(mainMod .. " + CTRL + l", hl.dsp.exec_cmd("hyprctl dispatch workspace m+1"), { description = "Next workspace" })

-- hold Super and drag with the left / right mouse button to move / resize a
-- window (the one place a bind is pointer-driven rather than a key).
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- a general-purpose scratchpad on its own special workspace (btop is no
-- longer a special workspace as of ADR 134 — it is plain workspace 12, see
-- WINDOWS AND WORKSPACES below).
hl.bind(mainMod .. " + A",         hl.dsp.workspace.toggle_special("scratch"), { description = "Toggle the scratchpad" })
hl.bind(mainMod .. " + SHIFT + A", hl.dsp.window.move({ workspace = "special:scratch" }), { description = "Send the window to the scratchpad" })

-- docs/TODO.md: "add borders to the whole view when in the scratchpad or
-- make it recognisable". Deliberately a pure-Hyprland-side fix, not
-- phi-shell: this project's own memory notes (verified against
-- quickshell-mirror/quickshell's own C++ IPC source for the pinned 0.3.1
-- version) found Quickshell cannot read Hyprland's "special" workspace
-- state at all, so a phi-shell indicator was ruled a dead end for now.
-- `match.workspace = "special:scratch"` is confirmed (read Hyprland's own
-- `desktop/rule/Rule.cpp` matchPropFromString + `workspace/filter/
-- statement/SpecialAddressableNameStatement.cpp`) to be an exact match
-- against the workspace's addressable name, which is exactly what
-- `toggle_special("scratch")` above creates.
--
-- Scope deliberately stops at "border"/"recognisable": the separate Style
-- section TODO entry ("scratchpad should slide in from below, have
-- slightly more out spacing... accent-colored border") asks for the same
-- border plus a slide-in animation and wider gaps this entry does not
-- claim or attempt — see docs/VERIFICATION.md for the overlap note.
--
-- Both border_size and border_color are set on the *window* rule, not
-- workspace_rule (which also has a border_size field) — kept on one rule
-- system deliberately, to sidestep any question of whether a workspace
-- rule's border_size and a window rule's border_color compose or one
-- shadows the other when both target the same windows.
--
-- border_color deliberately passes TWO identical colour tokens ("accent
-- accent"), not one: this is Hyprland's own documented `bordercolor
-- <active> <inactive>` two-colour form, not a single colour. Traced
-- `addWindowRuleEffectFromLua` (`config/lua/bindings/
-- LuaBindingsInternal.cpp`) into `parseBorderColorRule`
-- (`desktop/rule/windowRule/WindowRule.cpp`) to confirm the Lua wrapper
-- actually reaches that two-colour form: a SINGLE colour string parses
-- cleanly as one CLuaConfigGradient, whose `toString()` always emits
-- "<colour> <angle>deg" — and that shape (a second token containing
-- "deg") is read by parseBorderColorRule as ACTIVE colour + angle only,
-- leaving the inactive border at its default. The border would vanish the
-- instant the scratchpad window lost focus, defeating "recognisable". Two
-- literal colour tokens with no "deg" suffix on the second fail
-- CLuaConfigGradient's single-colour parse (its `#RRGGBB` branch rejects
-- the extra characters), which is what routes the raw string through the
-- wrapper's explicit `allowLegacyString` fallback into Hyprland's real
-- two-colour parser instead — confirmed by reading both functions, not
-- assumed.
hl.window_rule({
    name  = "scratchpad-border",
    match = { workspace = "special:scratch" },

    border_size  = 3,
    border_color = "${PHI_ACCENT} ${PHI_ACCENT}",
})

-- multi-monitor (inert on a single-output host — zotac is the only one with
-- two). exec_cmd rather than `focus({ monitor = ... })`: the direction token
-- Hyprland's `focusmonitor` dispatcher wants here (`+1`/`-1`) is confirmed,
-- the Lua wrapper's accepted form for it is not.
hl.bind(mainMod .. " + comma",  hl.dsp.exec_cmd("hyprctl dispatch focusmonitor -1"), { description = "Focus the previous monitor" })
hl.bind(mainMod .. " + period", hl.dsp.exec_cmd("hyprctl dispatch focusmonitor +1"), { description = "Focus the next monitor" })
hl.bind(mainMod .. " + SHIFT + comma",  hl.dsp.exec_cmd("hyprctl dispatch movewindow mon:-1"), { description = "Move the window to the previous monitor" })
hl.bind(mainMod .. " + SHIFT + period", hl.dsp.exec_cmd("hyprctl dispatch movewindow mon:+1"), { description = "Move the window to the next monitor" })

-- resize mode: Super+R, then arrows or h/j/k/l to resize the active window,
-- Escape / Return / any other key to leave. Same "mode for a rare action"
-- pattern as the screenshot submap further down.
hl.bind(mainMod .. " + R", hl.dsp.submap("resize"), { description = "Enter resize mode" })
hl.define_submap("resize", function()
    hl.bind("left",  hl.dsp.exec_cmd("hyprctl dispatch resizeactive -40 0"))
    hl.bind("right", hl.dsp.exec_cmd("hyprctl dispatch resizeactive 40 0"))
    hl.bind("up",    hl.dsp.exec_cmd("hyprctl dispatch resizeactive 0 -40"))
    hl.bind("down",  hl.dsp.exec_cmd("hyprctl dispatch resizeactive 0 40"))
    hl.bind("h",     hl.dsp.exec_cmd("hyprctl dispatch resizeactive -40 0"))
    hl.bind("l",     hl.dsp.exec_cmd("hyprctl dispatch resizeactive 40 0"))
    hl.bind("k",     hl.dsp.exec_cmd("hyprctl dispatch resizeactive 0 -40"))
    hl.bind("j",     hl.dsp.exec_cmd("hyprctl dispatch resizeactive 0 40"))
    hl.bind("Escape", hl.dsp.submap("reset"))
    hl.bind("Return", hl.dsp.submap("reset"))
    hl.bind("catchall", hl.dsp.submap("reset"))
end)

