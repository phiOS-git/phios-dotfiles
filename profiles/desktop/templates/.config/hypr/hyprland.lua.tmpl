hl.bind(mainMod .. " + R", hl.dsp.submap("resize"), { description = "Enter resize mode" }) -- FIXME: not working
hl.define_submap("resize", function()
    local function nudge(dx, dy)
        return function()
            local w = hl.get_active_window()
            if w then hl.dispatch(hl.dsp.window.resize({ x = w.size.x + dx, y = w.size.y + dy })) end
        end
    end
    hl.bind("left", nudge(-40, 0))
    hl.bind("right", nudge(40, 0))
    hl.bind("up", nudge(0, -40))
    hl.bind("down", nudge(0, 40))
    -- hl.bind("h", nudge(-40, 0))
    -- hl.bind("l", nudge(40, 0))
    -- hl.bind("k", nudge(0, -40))
    -- hl.bind("j", nudge(0, 40))
    hl.bind("Escape", hl.dsp.submap("reset"))
    hl.bind("Return", hl.dsp.submap("reset"))
    hl.bind("catchall", hl.dsp.submap("reset"))
end)

