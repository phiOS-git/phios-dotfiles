hl.gesture({
    fingers = 3,
    direction = "up",
    action = function() hl.exec_cmd(qsIpc("alttab", "open")) end,
}, { description = "Swipe up to open the Alt+Tab surface" })
hl.gesture({
    fingers = 3,
    direction = "down",
    action = function() hl.exec_cmd(qsIpc("alttab", "close")) end,
}, { description = "Swipe up/down to open/close the Alt+Tab surface" })

pcall(function()
    hl.gesture({
        fingers = 3,
        direction = "left",
        action = function() hl.exec_cmd("qs -p " .. qsConfigPath .. " ipc call workspace next") end,
    }, { description = "Swipe left/right to switch workspaces" })
    hl.gesture({
        fingers = 3,
        direction = "right",
        action = function() hl.exec_cmd("qs -p " .. qsConfigPath .. " ipc call workspace prev") end,
    }, { description = "Swipe left/right to switch workspaces" })
end)

