-- numbered workspaces (Super+1..0), and send-to-workspace (Super+Shift+1..0).
-- Loop taken verbatim from example/hyprland.lua, including `i % 10` mapping
-- workspace 10 onto the "0" key.
for i = 1, 10 do
    local key = i % 10
    hl.bind(mainMod .. " + " .. key, hl.dsp.focus({ workspace = i }), { description = "Go to workspace " .. i })
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }),
        { description = "Send the window to workspace " .. i })
end

hl.bind(mainMod .. " + CTRL + left", hl.dsp.exec_cmd("qs -p " .. qsConfigPath .. " ipc call workspace prev"),
    { description = "Previous workspace" }) -- FIXME: 'ipc call workspace next' does not work (check gestures section as well)
hl.bind(mainMod .. " + CTRL + right", hl.dsp.exec_cmd("qs -p " .. qsConfigPath .. " ipc call workspace next"),
    { description = "Next workspace" })

hl.bind(mainMod .. " + CTRL + h", hl.dsp.exec_cmd("qs -p " .. qsConfigPath .. " ipc call workspace prev"),
    { description = "Previous workspace" })
hl.bind(mainMod .. " + CTRL + l", hl.dsp.exec_cmd("qs -p " .. qsConfigPath .. " ipc call workspace next"),
    { description = "Next workspace" })

