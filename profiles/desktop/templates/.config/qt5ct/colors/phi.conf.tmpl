# phiOS — Qt5 palette for qt5ct (S-41). Identical content to
# ../../qt6ct/colors/phi.conf.tmpl — qt6ct is qt5ct's own Qt6 port and
# qt5ct's [ColorScheme] format is what that verification actually covered
# (qt6ct inherited it, not the reverse), so this file is the more directly
# confirmed of the pair, not the copy. See the qt6ct template for the full
# role-order rationale; not repeated here to avoid the two drifting apart
# in prose while staying identical in content.

[ColorScheme]
active_colors=${PHI_FG_0}, ${PHI_BG_2}, ${PHI_BG_3}, ${PHI_BG_2}, ${PHI_BG_0}, ${PHI_BG_1}, ${PHI_FG_0}, ${PHI_FG_0}, ${PHI_FG_0}, ${PHI_BG_0}, ${PHI_BG_1}, ${PHI_BG_0}, ${PHI_ACCENT}, ${PHI_ACCENT_FG}, ${PHI_ACCENT}, ${PHI_ACCENT}, ${PHI_BG_2}, ${PHI_BG_1}, ${PHI_BG_2}, ${PHI_FG_0}, ${PHI_FG_2}
inactive_colors=${PHI_FG_0}, ${PHI_BG_2}, ${PHI_BG_3}, ${PHI_BG_2}, ${PHI_BG_0}, ${PHI_BG_1}, ${PHI_FG_0}, ${PHI_FG_0}, ${PHI_FG_0}, ${PHI_BG_0}, ${PHI_BG_1}, ${PHI_BG_0}, ${PHI_ACCENT}, ${PHI_ACCENT_FG}, ${PHI_ACCENT}, ${PHI_ACCENT}, ${PHI_BG_2}, ${PHI_BG_1}, ${PHI_BG_2}, ${PHI_FG_0}, ${PHI_FG_2}
disabled_colors=${PHI_FG_3}, ${PHI_BG_2}, ${PHI_BG_3}, ${PHI_BG_2}, ${PHI_BG_0}, ${PHI_BG_1}, ${PHI_FG_3}, ${PHI_FG_3}, ${PHI_FG_3}, ${PHI_BG_0}, ${PHI_BG_1}, ${PHI_BG_0}, ${PHI_BORDER}, ${PHI_FG_3}, ${PHI_FG_3}, ${PHI_FG_3}, ${PHI_BG_2}, ${PHI_BG_1}, ${PHI_BG_2}, ${PHI_FG_3}, ${PHI_FG_3}
