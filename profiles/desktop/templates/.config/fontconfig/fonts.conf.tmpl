<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<!--
  phiOS — per-user fontconfig fallback chain. Generated from design tokens.
  Covers every GTK/Qt/native app that resolves generic "monospace"/"sans-serif"/
  "serif" families (kitty resolves fonts through its own config, not these
  generic aliases — see kitty/fonts.conf.tmpl).

  Chain for each role (three steps):
    1. the role's own family (font-mono / font-ui / font-reading)
    2. font-symbol — glyphs only (Nerd Font icons for apps using fontconfig)
    3. targeted Noto — Greek and extended Latin coverage only. No CJK: only
       noto-fonts is declared in this repo, not noto-fonts-cjk group.

  Noto family names differ per width: each alias targets the Noto family
  matching its role's metrics (monospace=fixed-width, sans/serif=proportional).
-->
<fontconfig>
  <alias>
    <family>monospace</family>
    <prefer>
      <family>${PHI_FONT_MONO}</family>
      <family>${PHI_FONT_SYMBOL}</family>
      <family>Noto Sans Mono</family>
    </prefer>
  </alias>
  <alias>
    <family>sans-serif</family>
    <prefer>
      <family>${PHI_FONT_UI}</family>
      <family>${PHI_FONT_SYMBOL}</family>
      <family>Noto Sans</family>
    </prefer>
  </alias>
  <alias>
    <family>serif</family>
    <prefer>
      <family>${PHI_FONT_READING}</family>
      <family>${PHI_FONT_SYMBOL}</family>
      <family>Noto Serif</family>
    </prefer>
  </alias>
</fontconfig>
