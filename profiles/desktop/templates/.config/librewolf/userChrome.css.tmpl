/* phiOS — Librewolf accent injection (scope: selected tab + URL bar focus).
 * NOT WIRED into design/adapters.txt yet: Librewolf/Firefox profiles are
 * named with random 8-char prefix at first launch, not a fixed path
 * the template-to-destination mechanism can target. Ready to be copied once
 * a destination-resolution step exists (reading ~/.librewolf/profiles.ini's
 * Path= key). Light/dark preference is handled by portal setting (same as
 * any GTK app); this file is accent only, on top of Librewolf's base theme.
 */

:root {
  --tab-selected-bgcolor: ${PHI_ACCENT} !important;
  --toolbar-field-focus-border-color: ${PHI_ACCENT} !important;
}
