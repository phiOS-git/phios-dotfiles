# phiOS — GTK4 settings. Same reasoning as gtk-3.0/settings.ini.tmpl:
# static fallback for apps that read this file instead of portal preference.
# gtk-decoration-layout empty suppresses CSD buttons (same caveat with
# libadwaita hardcoded HeaderBar as gtk-3.0). gtk-cursor-theme-name/-size
# redundant with env vars but kept as fallback (see gtk-3.0/settings.ini.tmpl).
#
# Class C (no runtime reload).

[Settings]
gtk-application-prefer-dark-theme=${PHI_VARIANT_IS_DARK}
gtk-decoration-layout=
gtk-cursor-theme-name=${PHI_CURSOR_THEME}
gtk-cursor-theme-size=${PHI_CURSOR_SIZE}
