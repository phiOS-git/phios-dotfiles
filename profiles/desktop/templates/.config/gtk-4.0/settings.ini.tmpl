# phiOS — GTK4 settings (S-41). Same reasoning as gtk-3.0/settings.ini.tmpl
# in the sibling directory: the static fallback for an app that reads this
# file directly rather than the portal preference (phi theme set writes
# both). gtk-decoration-layout empty is GTK4's CSD-button suppression —
# same Q-N05 decision, same libadwaita-hardcoded-HeaderBar caveat.
#
# Class C, same reasoning as gtk.css.tmpl in this same directory.

[Settings]
gtk-application-prefer-dark-theme=${PHI_VARIANT_IS_DARK}
gtk-decoration-layout=
