{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": [],
  "provider": {
    "phi-broker": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "phi broker (A2)",
      "options": {
        "baseURL": "http://127.0.0.1:8790/v1",
        "apiKey": "the-real-key-is-held-by-phi-agent-broker"
      },
      "models": {
        "REPLACE-WITH-YOUR-MODEL-ID": { "name": "phi broker model" }
      }
    }
  },
  "model": "phi-broker/REPLACE-WITH-YOUR-MODEL-ID",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "/home/agent/.config/opencode/**": "deny",
      "/home/agent/.local/share/opencode/**": "deny",
      "/home/agent/.local/state/**": "deny"
    },
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git remote*": "deny",
      "git fetch*": "deny",
      "git pull*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "deny",
    "doom_loop": "ask"
  }
}
