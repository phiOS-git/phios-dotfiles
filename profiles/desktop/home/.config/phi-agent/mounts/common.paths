# phi-agent — common read-only base, both instances.
#
# Grammar: see the header of ~/.local/bin/phi-agent-contain.
# Everything here is the minimum a modern userspace binary needs; nothing
# carries user data. A later bind in an instance file can shadow a path.

# The system tree. /bin /sbin /lib /lib64 are symlinks into it on Arch.
ro   /usr                       /usr
sym  usr/bin                    /bin
sym  usr/bin                    /sbin
sym  usr/lib                    /lib
sym  usr/lib                    /lib64

# Name resolution and TLS trust. resolv.conf/hosts are needed by A1 (live
# network) and harmless for A2 (which resolves through the proxy). The CA
# bundle is needed by both: A1 for direct HTTPS, A2 for end-to-end TLS to
# the provider tunnelled through the plaintext proxy CONNECT.
#
# resolv.conf is "?" because on a systemd-resolved host it's a symlink into
# /run (fresh tmpfs in container). bwrap resolves it on the host side when it
# can; starting with no DNS is better than refusing to start.
ro?  /etc/resolv.conf           /etc/resolv.conf
ro   /etc/hosts                 /etc/hosts
ro   /etc/nsswitch.conf         /etc/nsswitch.conf
ro   /etc/ssl                   /etc/ssl
ro?  /etc/ca-certificates       /etc/ca-certificates
ro?  /etc/pki                   /etc/pki

# Numeric-id resolution and the local timezone. passwd/group are the real
# system files, read-only — the container has no shadow, no gshadow.
ro   /etc/passwd                /etc/passwd
ro   /etc/group                 /etc/group
ro?  /etc/localtime             /etc/localtime

# ca-certificates keeps its runtime bundle under /etc; some distros also
# look in /usr/share which is already covered by the /usr bind above.

# The container home is an empty directory; the instance file mounts the
# agent's own XDG trees underneath it.
dir  /home/agent

# NEVER here, and there is no line you can add without it being obvious in
# review: /home outside /home/agent, rest of $HOME, ~/.ssh, ~/.gnupg,
# ~/.password-store, ~/.mozilla, ~/.local/mail, /var /srv /opt /mnt /boot
# /efi, /etc beyond these, and every session socket ($XDG_RUNTIME_DIR,
# Wayland, D-Bus session bus, PipeWire, SSH-agent socket).
# See mounts/never.paths for the machine-readable version.
