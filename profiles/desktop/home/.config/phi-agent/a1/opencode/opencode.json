{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,

  "provider": {
    "phi-broker": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "phi broker (A1)",
      "options": {
        "baseURL": "http://127.0.0.1:8789/v1",
        "apiKey": "the-real-key-is-held-by-phi-agent-broker"
      },
      "models": {
        "REPLACE-WITH-YOUR-MODEL-ID": { "name": "phi broker model" }
      }
    }
  },
  "model": "phi-broker/REPLACE-WITH-YOUR-MODEL-ID",

  "instructions": [
    "/home/agent/project/progetto.md",
    "/home/agent/project/memoria.md"
  ],

  "agent": {
    "general": {
      "mode": "primary",
      "prompt": "{file:/home/agent/.local/share/personalita/general.md}"
    },
    "technical": {
      "mode": "primary",
      "prompt": "{file:/home/agent/.local/share/personalita/technical.md}"
    }
  },
  "default_agent": "general",

  "mcp": {
    "phi": { "type": "local", "command": ["phi", "agent", "mcp"], "enabled": true }
  },

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "/home/agent/.config/opencode/**": "deny",
      "/home/agent/.local/share/opencode/**": "deny",
      "/home/agent/.local/state/**": "deny"
    },
    "edit": "ask",
    "bash": "deny",
    "task": "deny",
    "webfetch": "ask",
    "websearch": "allow",
    "external_directory": {
      "*": "deny",
      "/home/agent/notes/**": "allow",
      "/home/agent/.local/share/personalita/**": "allow",
      "/home/agent/.config/opencode/**": "deny",
      "/home/agent/.local/share/opencode/**": "deny",
      "/home/agent/.local/state/**": "deny"
    },
    "doom_loop": "ask"
  }
}
