# phiOS — provider-credential broker, one instance per profile class (a1
# for general/academic/inline, a2 for coding).
# Declared in services-user.txt, NEVER enabled by the installer.
#
#   systemctl --user enable --now phi-agent-broker@a1.service
#
# The broker holds the provider key and is the only route pi has to the
# provider (its models.json baseUrl points at 127.0.0.1). If the broker is
# down, pi gets connection-refused and no agent works — which is the
# intended fail-closed behaviour, not a bug to paper over.
#
# Ordering toward the broker is declared by each consumer (phi-agent.service
# for a1, phi-agent-contain's coding branch for a2 at launch time), not here:
# there is no longer a single per-instance engine unit to name generically.
#
# UNVERIFIED: the hardening directives below are written from systemd.exec(5)
# and have not been run. If the unit fails to start, loosen from the bottom
# up (SystemCallFilter and MemoryDenyWriteExecute first — Go binaries
# sometimes trip the latter) and report which line it was.

[Unit]
Description=phiOS AI agent credential broker (%i)
Documentation=https://github.com/phiOS-git/phios-dotfiles

[Service]
Type=simple
# Fail-closed: --check validates broker.json and that the key is loadable
# before the socket is ever bound.
ExecStartPre=/usr/bin/phi agent broker --instance %i --check
ExecStart=/usr/bin/phi agent broker --instance %i
Restart=on-failure
RestartSec=2

# The key enters the broker's process only, via a systemd credential from a
# user-owned file with mode 600 — never a repository, never a plain
# Environment= line. $CREDENTIALS_DIRECTORY is a 0700 tmpfs
# not inherited by children.
LoadCredential=provider-key:%h/.config/phi-agent/%i/provider-key
Environment=PHI_AGENT_BROKER_KEY_FILE=%d/provider-key

# Resource limits, no privilege escalation, private tmp, kernel hardening.
MemoryMax=256M
TasksMax=64
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/phi-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=default.target
