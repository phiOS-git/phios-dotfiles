#!/usr/bin/env bash
#
# phi-agent-contain — start an AI agent instance inside a bubblewrap
# containment built FROM EMPTY (docs/phios-agente.md §4, ADR 087).
#
#   phi-agent-contain a1|a2 [--dry-run] -- COMMAND [ARG...]
#
# A path that is not mounted below does not exist for the process, whatever
# command it runs (§4.1). This script is the ONLY way the two opencode
# instances are ever launched: the systemd user units (S-71/S-74) and
# `phi agent ask` (S-74) all go through it. There is no path that starts an
# agent outside the containment, by design (§4.7, ADR 090).
#
# Fail-closed (§4.7 / V-04): if bubblewrap is missing, unusable, or the
# kernel refuses the namespaces, this script prints one line to stderr and
# exits non-zero WITHOUT running COMMAND. A unit whose ExecStart is this
# script therefore lands in `failed` with no engine process — which is the
# whole of V-04. There is deliberately no degraded mode.
#
# What this script does NOT do, on purpose:
#   - It never reads the caller's environment into the container: --clearenv
#     drops everything and only the explicit allowlist below (add_env calls)
#     is put back (§4.6). The SSH-agent socket, the session bus, Wayland, and
#     every *_API_KEY / *_TOKEN are excluded by construction, not by a filter.
#   - It never enables a systemd unit, installs a package, or writes outside
#     the agent's own XDG trees.
#
# Dependency budget: bash + coreutils + bubblewrap. No jq, no python.
#
# UNVERIFIED FROM THE BUILD MACHINE: this whole invocation is written from
# §4 and bwrap(1); it has never run. V-01..V-04 (phios-agente.md §15) are
# the proof and are USER operations on zotac / razer. See PROGRESS.md S-70.

set -euo pipefail

readonly PROG=phi-agent-contain

# Container-side layout. Both instances see the same shape; only the mounts
# behind it differ (mounts/a1.paths vs mounts/a2.paths).
readonly CONTAINER_HOME=/home/agent
readonly CONTAINER_RUNTIME=/run/phi-agent

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
	cat <<-USAGE
	usage: $PROG <a1|a2> [--dry-run] -- COMMAND [ARG...]

	Starts COMMAND inside the bubblewrap containment for the named instance.
	--dry-run prints the assembled bwrap argument vector and exits 0 without
	running anything — use it to inspect exactly what is and is not mounted.

	Environment (from ~/.config/phi-agent/env, see env.example):
	  PHI_AGENT_NOTES_DIR        A1 note archive, mounted read-only  (default ~/notes)
	  PHI_AGENT_CODE_ROOT        A2 code projects root, writable     (default ~/code)
	  PHI_AGENT_PROJECT          A1 active project name              (default: none)
	  PHI_AGENT_A2_TOOLCHAIN_CACHE  A2-only toolchain cache, writable
	  GIT_AUTHOR_NAME / GIT_AUTHOR_EMAIL   A2 git identity (never a mounted .gitconfig)
	USAGE
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

instance=
dry_run=0
remote=0
cmd=()

while (($#)); do
	case $1 in
		a1|a2) [[ -z $instance ]] || die "instance given twice"; instance=$1; shift ;;
		--dry-run) dry_run=1; shift ;;
		--remote) remote=1; shift ;;
		-h|--help) usage; exit 0 ;;
		--) shift; cmd=("$@"); break ;;
		*) die "unexpected argument: $1 (try --help)" ;;
	esac
done

[[ -n $instance ]] || { usage >&2; die "no instance (a1|a2)"; }
((${#cmd[@]})) || die "no command after --"
if ((remote)); then
	[[ $instance == a2 ]] || die "--remote is A2 only (phios-agente.md §10.3)"
fi

# ---------------------------------------------------------------------------
# Fail-closed preflight (V-04)
# ---------------------------------------------------------------------------

bwrap=$(command -v bwrap 2>/dev/null) || die "containment unavailable: bwrap not found"
[[ -x $bwrap ]] || die "containment unavailable: $bwrap is not executable"
"$bwrap" --version >/dev/null 2>&1 || die "containment unavailable: '$bwrap --version' failed"

# Unprivileged user namespaces must be available unless bwrap is setuid-root.
# On Arch the package is not setuid (it relies on unprivileged userns), so a
# kernel with them disabled means no containment — and therefore no startup.
if [[ ! -u $bwrap ]]; then
	if [[ -r /proc/sys/kernel/unprivileged_userns_clone ]] \
		&& [[ $(< /proc/sys/kernel/unprivileged_userns_clone) == 0 ]]; then
		die "containment unavailable: unprivileged user namespaces disabled (kernel.unprivileged_userns_clone=0)"
	fi
	if [[ -r /proc/sys/user/max_user_namespaces ]] \
		&& [[ $(< /proc/sys/user/max_user_namespaces) == 0 ]]; then
		die "containment unavailable: user.max_user_namespaces=0"
	fi
fi

# ---------------------------------------------------------------------------
# Configuration roots
# ---------------------------------------------------------------------------

conf_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
cache_home=${XDG_CACHE_HOME:-$HOME/.cache}

# Per-instance XDG trees (§3.3, ADR 086): separate config, data, state and
# cache, from which separate credentials and history follow. The two
# instances never share a path.
AGENT_CONFIG=$conf_home/phi-agent/$instance
AGENT_DATA=$data_home/phi-agent/$instance
AGENT_STATE=$state_home/phi-agent/$instance
AGENT_CACHE=$cache_home/phi-agent/$instance

env_file=$conf_home/phi-agent/env
if [[ -r $env_file ]]; then
	# The file is sourced as a shell fragment. The one footgun is an
	# unquoted space in a value: `KEY=a b` runs `b` as a command and, under
	# `set -e`, aborts here with a bare "command not found". Catch it first
	# and say what is wrong.
	while IFS= read -r _line || [[ -n $_line ]]; do
		_line=${_line%%#*}
		if [[ $_line =~ ^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=[^[:space:]\"\']*[[:space:]]+[^[:space:]] ]]; then
			die "$env_file: unquoted space in a value — write KEY=\"a b\":${_line}"
		fi
	done < "$env_file"
	# shellcheck disable=SC1090
	set -a; . "$env_file"; set +a
fi

NOTES=${PHI_AGENT_NOTES_DIR:-$HOME/notes}
CODE_ROOT=${PHI_AGENT_CODE_ROOT:-$HOME/code}

# Active project: the env var wins; otherwise the marker `phi agent project
# use` writes. Neither set = no project (valid for the V-01..V-04 proof).
PROJECT_NAME=${PHI_AGENT_PROJECT:-}
if [[ -z $PROJECT_NAME && -r $AGENT_STATE/active-project ]]; then
	PROJECT_NAME=$(< "$AGENT_STATE/active-project")
	PROJECT_NAME=${PROJECT_NAME//[$'\t\r\n ']/}
fi
PROJECT_DIR=
if [[ -n $PROJECT_NAME ]]; then
	PROJECT_DIR=$AGENT_DATA/projects/$PROJECT_NAME
fi
A2_TOOLCHAIN_CACHE=${PHI_AGENT_A2_TOOLCHAIN_CACHE:-$AGENT_CACHE/toolchains}

mounts_dir=$conf_home/phi-agent/mounts
[[ -d $mounts_dir ]] || die "containment unavailable: $mounts_dir not found"

# The instance's own XDG roots must exist for the writable binds to work.
# These belong to this instance alone — creating them here is not a
# perimeter decision, it is making the perimeter's own write areas real on
# a machine that has never run the agent. The §8.2 data model
# (personalita/, projects/) is NOT created here: that is S-73 and
# `phi agent project`.
mkdir -p -- "$AGENT_DATA" "$AGENT_STATE" "$AGENT_CACHE"
[[ $instance == a2 ]] && mkdir -p -- "$A2_TOOLCHAIN_CACHE"

# ---------------------------------------------------------------------------
# Path-list expansion
# ---------------------------------------------------------------------------
#
# mounts/*.paths grammar, one directive per line (# starts a comment):
#
#   ro   SRC DEST     read-only bind; FATAL if SRC is missing
#   ro?  SRC DEST     read-only bind; skipped silently if SRC is missing
#   rw   SRC DEST     writable bind;  FATAL if SRC is missing
#   rw?  SRC DEST     writable bind;  skipped silently if SRC is missing
#   dir  DEST         create an empty directory in the container
#   sym  TARGET LINK  create a symlink in the container
#
# Ordering matters and is intentional: bubblewrap applies binds left to
# right and a later bind wins. mounts/a1.paths binds the project read-only
# first, then re-binds output/ and proposte/ writable underneath it — so
# memoria.md and materiali/ stay read-only with no explicit rule, and
# S-73 only has to make that guarantee louder, not create it (§8.4).

bind_args=()

expand() {
	local s=$1
	s=${s//@CONTAINER_HOME@/$CONTAINER_HOME}
	s=${s//@CONTAINER_RUNTIME@/$CONTAINER_RUNTIME}
	s=${s//@AGENT_CONFIG@/$AGENT_CONFIG}
	s=${s//@AGENT_DATA@/$AGENT_DATA}
	s=${s//@AGENT_STATE@/$AGENT_STATE}
	s=${s//@AGENT_CACHE@/$AGENT_CACHE}
	s=${s//@NOTES@/$NOTES}
	s=${s//@CODE_ROOT@/$CODE_ROOT}
	s=${s//@A2_TOOLCHAIN_CACHE@/$A2_TOOLCHAIN_CACHE}
	s=${s//@PROJECT@/$PROJECT_DIR}
	printf '%s' "$s"
}

read_paths() {
	local file=$1 kind a b line
	[[ -f $file ]] || die "containment unavailable: $file not found"
	while IFS= read -r line || [[ -n $line ]]; do
		line=${line%%#*}
		line=${line#"${line%%[![:space:]]*}"}
		line=${line%"${line##*[![:space:]]}"}
		[[ -n $line ]] || continue
		# A line that references the active project is skipped entirely when
		# no project is selected — otherwise "@PROJECT@/memoria.md" would
		# expand to the bogus absolute path "/memoria.md".
		[[ $line == *@PROJECT@* && -z $PROJECT_DIR ]] && continue
		# shellcheck disable=SC2086
		set -- $line
		kind=$1; a=$(expand "${2:-}"); b=$(expand "${3:-}")
		case $kind in
			ro|rw)
				# Required: refuse to start if the source is missing (§4.7).
				[[ -n $a ]] || die "$file: '$kind' with no source (unset @VAR@?)"
				[[ -n $b ]] || b=$a
				[[ -e $a ]] || die "containment unavailable: required mount source missing: $a"
				[[ $kind == ro ]] && bind_args+=(--ro-bind "$a" "$b") || bind_args+=(--bind "$a" "$b")
				;;
			ro\?|rw\?)
				# Optional: an empty @VAR@ or a missing path is silently
				# skipped by bubblewrap's own *-try variant.
				[[ -n $a ]] || continue
				[[ -n $b ]] || b=$a
				[[ $kind == ro\? ]] && bind_args+=(--ro-bind-try "$a" "$b") || bind_args+=(--bind-try "$a" "$b")
				;;
			dir)  [[ -n $a ]] || die "$file: 'dir' with no path";  bind_args+=(--dir "$a") ;;
			sym)  [[ -n $a && -n $b ]] || die "$file: 'sym' needs TARGET LINK"; bind_args+=(--symlink "$a" "$b") ;;
			*)    die "$file: unknown directive: $kind" ;;
		esac
	done < "$file"
}

read_paths "$mounts_dir/common.paths"
read_paths "$mounts_dir/$instance.paths"

# ---------------------------------------------------------------------------
# Environment allowlist (§4.6) — put back ONLY these, after --clearenv.
# ---------------------------------------------------------------------------

setenv_args=(--clearenv)
add_env() { setenv_args+=(--setenv "$1" "$2"); }

add_env HOME "$CONTAINER_HOME"
add_env PATH /usr/bin
add_env TERM "${TERM:-xterm-256color}"
add_env LANG "${LANG:-C.UTF-8}"
add_env XDG_CONFIG_HOME "$CONTAINER_HOME/.config"
add_env XDG_DATA_HOME "$CONTAINER_HOME/.local/share"
add_env XDG_STATE_HOME "$CONTAINER_HOME/.local/state"
add_env XDG_CACHE_HOME "$CONTAINER_HOME/.cache"
add_env XDG_RUNTIME_DIR "$CONTAINER_RUNTIME"
add_env OPENCODE_CONFIG "$CONTAINER_HOME/.config/opencode/opencode.json"
add_env NO_PROXY 127.0.0.1,localhost
add_env PHI_AGENT_INSTANCE "$instance"

net_args=()
case $instance in
	a1)
		# A1 keeps the host network namespace: its job is to fetch pages the
		# search turned up, and control there is interactive approval at the
		# engine, not a static list (§5.2). It reaches the brokering service
		# on host loopback directly.
		[[ -n $PROJECT_NAME ]] && add_env PHI_AGENT_PROJECT "$PROJECT_NAME"
		;;
	a2)
		# A2's network boundary IS the namespace, not a variable (§5.1):
		# --unshare-net gives it a fresh namespace with only a down
		# loopback. The ONLY way out is two unix sockets, created on the
		# host and reachable through the bridge dir bound below:
		#   net/proxy.sock     -> host tinyproxy (the §5.1 egress whitelist)
		#   net/broker-a2.sock -> the A2 credential broker (§6.2)
		# The in-container command is wrapped further down with two socat
		# forwarders that turn those sockets into loopback TCP ports. A
		# process that unsets HTTP(S)_PROXY reaches tinyproxy on nothing
		# and is left with NO network, not free network — which is V-03.
		net_args+=(--unshare-net)

		bridge_dir=$state_home/phi-agent/net
		mkdir -p -- "$bridge_dir"
		bind_args+=(--bind "$bridge_dir" /run/phi-agent/net)

		add_env HTTP_PROXY  "http://127.0.0.1:8118"
		add_env HTTPS_PROXY "http://127.0.0.1:8118"
		add_env http_proxy  "http://127.0.0.1:8118"
		add_env https_proxy "http://127.0.0.1:8118"

		add_env GIT_AUTHOR_NAME "${GIT_AUTHOR_NAME:-phi agent}"
		add_env GIT_AUTHOR_EMAIL "${GIT_AUTHOR_EMAIL:-phi-agent@localhost}"
		add_env GIT_COMMITTER_NAME "${GIT_COMMITTER_NAME:-${GIT_AUTHOR_NAME:-phi agent}}"
		add_env GIT_COMMITTER_EMAIL "${GIT_COMMITTER_EMAIL:-${GIT_AUTHOR_EMAIL:-phi-agent@localhost}}"

		# The two OUTBOUND forwarders, always. socat is /usr/bin/socat (the
		# /usr bind); the forwarders are children of this shell, which
		# --die-with-parent reaps with the container. NO_PROXY
		# (127.0.0.1,localhost, set above for both instances) routes the
		# broker call straight to the :8790 forwarder (-> broker-a2.sock),
		# while every other host goes through HTTPS_PROXY -> :8118 ->
		# proxy.sock -> tinyproxy's whitelist. A process that unsets the
		# proxy vars can then reach only the broker — which is V-03.
		wrap='
			/usr/bin/socat TCP-LISTEN:8118,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/phi-agent/net/proxy.sock &
			/usr/bin/socat TCP-LISTEN:8790,bind=127.0.0.1,fork,reuseaddr UNIX-CONNECT:/run/phi-agent/net/broker-a2.sock &'

		if ((remote)); then
			# --remote (§10.3): the ONLY time A2 gets a password and an
			# INBOUND socket. A default A2 launch has neither, so V-02 run
			# against it stays clean with nothing to explain. The overlay
			# address is bound by the HOST unit (phi-agent-a2-remote.service),
			# never in here and never in the repo — this side only exposes
			# opencode's loopback port on a unix socket the host reads.
			#
			# The password is bind-mounted as a file and read by the wrapper
			# into the environment INSIDE the container — never passed as a
			# --setenv value, which would put it in bwrap's argv where any
			# `ps` could read it.
			pw_file=${PHI_AGENT_REMOTE_PASSWORD_FILE:-${CREDENTIALS_DIRECTORY:+$CREDENTIALS_DIRECTORY/remote-password}}
			[[ -n $pw_file && -r $pw_file ]] || die "containment unavailable: --remote needs a readable password file (PHI_AGENT_REMOTE_PASSWORD_FILE or a systemd credential)"
			bind_args+=(--ro-bind "$pw_file" /run/phi-agent/remote-password)
			add_env OPENCODE_SERVER_USERNAME "${OPENCODE_SERVER_USERNAME:-phi}"
			# Assignment context (VAR=$(...)) does not word-split, so a
			# password with spaces survives; then export by name.
			wrap+='
			OPENCODE_SERVER_PASSWORD=$(cat /run/phi-agent/remote-password); export OPENCODE_SERVER_PASSWORD
			/usr/bin/socat UNIX-LISTEN:/run/phi-agent/net/a2-remote.sock,fork,reuseaddr TCP:127.0.0.1:4299 &'
		fi

		cmd=(/bin/sh -c "$wrap"'
			sleep 0.5
			exec "$@"
		' phi-agent-a2 "${cmd[@]}")
		;;
esac

# ---------------------------------------------------------------------------
# Namespaces and process rules (§4.6)
# ---------------------------------------------------------------------------

ns_args=(
	--unshare-user-try   # mandatory for the rest to be creatable unprivileged
	--unshare-pid
	--unshare-ipc
	--unshare-uts
	--unshare-cgroup
	--new-session        # mitigates TIOCSTI input injection
	--die-with-parent
	--hostname "phi-agent-$instance"
)

pseudo_args=(
	--proc /proc
	--dev /dev
	--tmpfs /tmp
	--tmpfs /run
	--dir "$CONTAINER_RUNTIME"
)

argv=(
	"${ns_args[@]}"
	"${net_args[@]}"
	"${pseudo_args[@]}"
	"${bind_args[@]}"
	--chdir "$CONTAINER_HOME"
	"${setenv_args[@]}"
	--
	"${cmd[@]}"
)

if ((dry_run)); then
	printf '%s\n' "$bwrap"
	printf '  %q' "${argv[@]}"
	printf '\n'
	exit 0
fi

exec "$bwrap" "${argv[@]}"
