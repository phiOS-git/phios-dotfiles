// phiOS -- Plymouth script theme (S-53, master plan Sec9.1, Sec6.6 Role A:
// "Tier 0, monocromo, immobile"). Syntax verified at S-53 against a real,
// live Plymouth script theme (github.com/jtyr/plymouth-theme-arch-breeze,
// fetched raw and read directly) for every primitive used: ImageNew/Image,
// SpriteNew/Sprite, SetImage, SetPosition, SetOpacity, Window.Get*,
// Window.SetBackground*Color, Image.Text, String.Length/Substring and the
// five Plymouth.Set*Function callback names.
//
// OOP-33 (out-of-plan, "auth-surfaces") -- second revision, on the user's
// review of OOP-30:
//   * The mark is now the Phi GLYPH drawn as text (Image.Text "Φ"), not
//     the phi.png raster -- smaller, thinner, more elegant, and it no
//     longer needs a rebuilt PNG this environment cannot produce. phi.png
//     stays in the theme dir, unused (ImageDir still points at it).
//   * The passphrase prompt and the masked characters are ONE centred
//     line inside an ASCII box (+---+ / | ... | / +---+), sitting ABOVE
//     the mark -- the box + `*` echo + block caret mirror the lock
//     screen's Widgets.Panel + masked-`*` + rectangle cursor.
//   * Composition: box centred at ~0.34 of the height, mark centred at
//     0.50. Every sprite is horizontally centred on its own measured
//     width.
//
// FONT ARGUMENT (Image.Text's 6th parameter, a Pango font string):
// script-lib-image.c has taken it for years, but S-53's own verification
// pass only exercised the 4-argument form. If the target's Plymouth build
// ignores or rejects it, the box borders will not align with a
// proportional font -- the fix is to drop the "monospace 16" / "Serif 96"
// arguments and accept the default font (the box then reads as brackets,
// the mark as a plain glyph). Flagged, not hidden.
//
// Colours are PHI_BG_0 and PHI_FG_0, dark variant, LITERAL: Plymouth runs
// in the initramfs, before phi exists, so it cannot read design/tokens
// (design/brand/README.md documents this divergence for every boot asset).
//   bg-0  #1a1918  ->  0.102, 0.098, 0.094
//   fg-0  #d6d1c9  ->  0.839, 0.820, 0.788

fg_r = 0.839;
fg_g = 0.820;
fg_b = 0.788;

MARK_FONT   = "Serif 96";      // thin, elegant; a judgement call, tune here
PROMPT_FONT = "monospace 16";  // must be monospace for the box to align
BOX_MIN     = 32;              // min inner width, so the box never jumps

// --- Background: Tier 0, still (Role A) ----------------------------------
Window.SetBackgroundTopColor(0.102, 0.098, 0.094);
Window.SetBackgroundBottomColor(0.102, 0.098, 0.094);

// --- The mark: the Phi glyph as text, centred at 0.50 -------------------
logo.image = Image.Text("Φ", fg_r, fg_g, fg_b, 1, MARK_FONT);
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() * 0.50 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1);

// --- Optional random-letters resolve on appearance ---------------------
// Style plan Sec5/Sec17: the random-letters effect "avrebbe una coerenza
// diretta se usato per la comparsa del marchio in boot -- non e' una
// regola imposta, solo un'opzione". OFFERED, not imposed: default OFF.
// Flip to 1 to try it; Category C (Sec6.5), a rare event, linear frames.
ENABLE_SCRAMBLE = 0;

if (ENABLE_SCRAMBLE) {
    logo.sprite.SetOpacity(0);

    scramble.alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    scramble.frame = 0;
    scramble.frames = 20;
    scramble.sprite = SpriteNew();
    scramble.sprite.SetX(logo.sprite.GetX());
    scramble.sprite.SetY(logo.sprite.GetY());
    scramble.sprite.SetOpacity(1);

    fun scramble_tick() {
        scramble.frame++;
        if (scramble.frame >= scramble.frames) {
            scramble.sprite.SetOpacity(0);
            logo.sprite.SetOpacity(1);
            return;
        }
        index = Math.Int(Math.Random() * String.Length(scramble.alphabet));
        letter = String.Substring(scramble.alphabet, index, 1);
        scramble.sprite.SetImage(Image.Text(letter, fg_r, fg_g, fg_b, 1, MARK_FONT));
        scramble.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - scramble.sprite.GetImage().GetWidth() / 2);
    }
}

// --- Boot progress: still, so nothing to draw per tick unless scrambling
fun refresh_callback() {
    if (ENABLE_SCRAMBLE && scramble.frame < scramble.frames) {
        scramble_tick();
    }
}

// --- LUKS passphrase prompt -------------------------------------------
// Confirmed against the reference: display_password_callback gets the
// prompt text and the NUMBER of characters typed, never the characters.
dialog.top = SpriteNew();
dialog.mid = SpriteNew();
dialog.bot = SpriteNew();
dialog.top.SetOpacity(0);
dialog.mid.SetOpacity(0);
dialog.bot.SetOpacity(0);

// No value-returning helper funs -- S-53's verification never exercised
// `return <expr>` from a user fun, so every string is built inline with a
// `for` loop (the one control form the reference script confirmed).
fun place_centered(sprite, image, y) {
    sprite.SetImage(image);
    sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2);
    sprite.SetY(y);
    sprite.SetOpacity(1);
}

fun show_password_prompt(prompt, bullets) {
    // One line: prompt, gap, `*` per typed character, block caret. `*` and
    // the U+2588 caret match Lock/Lock.qml's masked echo and rectangle
    // cursor; the box below mirrors its Widgets.Panel. Still: boot is
    // Role A ("immobile"), so the caret does not blink -- the live lock
    // screen is the one that does.
    stars = "";
    for (i = 0; i < bullets; i++) { stars = stars + "*"; }
    inner = prompt + "   " + stars + "█";
    for (i = String.Length(inner); i < BOX_MIN; i++) { inner = inner + " "; }

    rule = "";
    rlen = String.Length(inner) + 4;
    for (i = 0; i < rlen; i++) { rule = rule + "-"; }
    border = "+" + rule + "+";
    middle = "|  " + inner + "  |";

    top_img = Image.Text(border, fg_r, fg_g, fg_b, 1, PROMPT_FONT);
    mid_img = Image.Text(middle, fg_r, fg_g, fg_b, 1, PROMPT_FONT);
    bot_img = Image.Text(border, fg_r, fg_g, fg_b, 1, PROMPT_FONT);
    line_h = top_img.GetHeight();

    base_y = Window.GetY() + Window.GetHeight() * 0.34;
    place_centered(dialog.top, top_img, base_y);
    place_centered(dialog.mid, mid_img, base_y + line_h);
    place_centered(dialog.bot, bot_img, base_y + line_h * 2);
}

fun hide_prompt() {
    dialog.top.SetOpacity(0);
    dialog.mid.SetOpacity(0);
    dialog.bot.SetOpacity(0);
}

fun display_normal_callback() {
    hide_prompt();
}

fun display_password_callback(prompt, bullets) {
    show_password_prompt(prompt, bullets);
}

fun quit_callback() {
    logo.sprite.SetOpacity(0);
    hide_prompt();
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetQuitFunction(quit_callback);
