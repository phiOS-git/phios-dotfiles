// phiOS -- Plymouth script theme (S-53, master plan Sec9.1, Sec6.6 Role A:
// "Tier 0, monocromo, immobile"). Syntax verified this session against a
// real, live Plymouth script theme (github.com/jtyr/plymouth-theme-arch-
// breeze, fetched raw via curl and read directly, not paraphrased) for
// every primitive used here: ImageNew/Image, SpriteNew/Sprite, SetImage,
// SetPosition, SetOpacity, Window.Get*, Window.SetBackground*Color,
// Image.Text, and the five Plymouth.Set*Function callback names. The
// password-bullet string-building loop below (an ordinary for-loop with
// string concatenation) follows the same C-like grammar the reference
// script's own for-loops use, but string concatenation itself was not
// independently confirmed byte-for-byte against that reference -- flagged,
// not guessed silently.
//
// Colours are PHI_BG_0 and PHI_FG_0, dark variant, literal (Plymouth runs
// before phi exists -- see design/brand/README.md for the full reasoning,
// shared by every asset this step produces). RGB values are the exact
// #1a1918 / #d6d1c9 hex divided by 255, computed once off-machine:
//   bg-0 = 0.102, 0.098, 0.094
//   fg-0 = 0.839, 0.820, 0.788

// --- Background: Tier 0, still (Role A) -------------------------------
Window.SetBackgroundTopColor(0.102, 0.098, 0.094);
Window.SetBackgroundBottomColor(0.102, 0.098, 0.094);

// --- The mark itself -----------------------------------------------------
// phi.png is the rasterised design/brand/phi-mono.svg shape (bar through
// an open ring), fg-0 on transparent -- see that SVG's own header for the
// exact geometry both were built from.
logo.image = Image("phi.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1);

// --- Optional random-letters resolve on appearance ------------------------
// Style plan Sec5/Sec17: "l'effetto random-letters... avrebbe una coerenza
// diretta se usato per la comparsa del marchio in boot -- non e' una regola
// imposta, solo un'opzione". OFFERED, not imposed: default OFF. Flip
// ENABLE_SCRAMBLE to 1 to turn it on -- this is the one line that decision
// costs, on purpose, so trying it and reverting never means re-deriving
// anything. Category C (Sec6.5): a rare event (boot), plain linear frame
// advance, no easing curve to speak of at this pixel scale.
ENABLE_SCRAMBLE = 0;

if (ENABLE_SCRAMBLE) {
    logo.sprite.SetOpacity(0);

    scramble.alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    scramble.frame = 0;
    scramble.frames = 20;
    scramble.sprite = SpriteNew();
    scramble.sprite.SetX(logo.sprite.GetX());
    scramble.sprite.SetY(logo.sprite.GetY());
    scramble.sprite.SetOpacity(1);

    fun scramble_tick() {
        scramble.frame++;
        if (scramble.frame >= scramble.frames) {
            scramble.sprite.SetOpacity(0);
            logo.sprite.SetOpacity(1);
            return;
        }
        index = Math.Int(Math.Random() * String.Length(scramble.alphabet));
        letter = String.Substring(scramble.alphabet, index, 1);
        scramble.sprite.SetImage(Image.Text(letter, 0.839, 0.820, 0.788));
        scramble.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - scramble.sprite.GetImage().GetWidth() / 2);
    }
}

// --- Boot progress: still, so nothing to draw per tick unless scrambling -
fun refresh_callback() {
    if (ENABLE_SCRAMBLE && scramble.frame < scramble.frames) {
        scramble_tick();
    }
}

// --- LUKS passphrase prompt (VERIFY: "the prompt is graphical") ----------
// Confirmed against the real reference: display_password_callback receives
// the prompt text and the number of characters typed so far, not the
// characters themselves -- Plymouth never exposes the passphrase to a
// theme script.
dialog.message = SpriteNew();
dialog.message.SetOpacity(0);

fun show_password_prompt(prompt, bullets) {
    dots = "";
    for (i = 0; i < bullets; i++) {
        dots = dots + "*";
    }
    dialog.text = Image.Text(prompt + "  " + dots, 0.839, 0.820, 0.788);
    dialog.message.SetImage(dialog.text);
    dialog.message.SetX(Window.GetX() + Window.GetWidth() / 2 - dialog.text.GetWidth() / 2);
    dialog.message.SetY(Window.GetY() + Window.GetHeight() * 0.75);
    dialog.message.SetOpacity(1);
}

fun display_normal_callback() {
    dialog.message.SetOpacity(0);
}

fun display_password_callback(prompt, bullets) {
    show_password_prompt(prompt, bullets);
}

fun quit_callback() {
    logo.sprite.SetOpacity(0);
    dialog.message.SetOpacity(0);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetQuitFunction(quit_callback);
