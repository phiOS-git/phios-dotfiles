// phiOS -- Plymouth script theme (S-53; rebuilt from scratch at OOP-36 on
// the user's review: "simplify and build it from scratch as it's a mess").
// Master plan Sec9.1, Sec6.6 Role A: "Tier 0, monocromo, immobile".
//
// Deliberately minimal. Only two Plymouth primitives that S-53 verified
// against a real script theme (arch-breeze) are used: Image("<file>") and
// the FOUR-argument Image.Text(text, r, g, b). No font argument (its
// support is not dependable across Plymouth builds -- that was the OOP-33
// failure), no sprite boxes, no scramble.
//
//   * The mark is phi.png -- the raster of design/brand/phi-ascii.txt
//     (regenerated by design/brand/render-phi-png.sh). Centred, upper.
//   * The LUKS passphrase is two centred lines below the mark: the prompt
//     on its own line, then the masked characters + a "_" caret on the
//     next.
//
// Colours are literal PHI_BG_0 / PHI_FG_0, dark -- Plymouth runs in the
// initramfs, before phi and the design tokens exist (design/brand/README.md).
//   bg-0  #1a1918  ->  0.102, 0.098, 0.094
//   fg-0  #d6d1c9  ->  0.839, 0.820, 0.788

fg_r = 0.839;
fg_g = 0.820;
fg_b = 0.788;

// --- Background --------------------------------------------------------
Window.SetBackgroundTopColor(0.102, 0.098, 0.094);
Window.SetBackgroundBottomColor(0.102, 0.098, 0.094);

// --- The mark ---------------------------------------------------------
mark.image = Image("phi.png");
mark.sprite = Sprite(mark.image);
mark.sprite.SetX(Window.GetX() + Window.GetWidth()  / 2 - mark.image.GetWidth()  / 2);
mark.sprite.SetY(Window.GetY() + Window.GetHeight() * 0.38 - mark.image.GetHeight() / 2);
mark.sprite.SetOpacity(1);

// --- LUKS passphrase prompt ------------------------------------------
// display_password_callback gets the prompt text and the NUMBER of
// characters typed, never the characters (confirmed against the reference).
prompt.sprite = SpriteNew();
entry.sprite = SpriteNew();
prompt.sprite.SetOpacity(0);
entry.sprite.SetOpacity(0);

// No value-returning user funs -- S-53's verification never exercised
// `return <expr>`, and OOP-33 broke partly on untested script features.
fun display_password_callback(text, bullets) {
    prompt.image = Image.Text(text, fg_r, fg_g, fg_b);
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(Window.GetY() + Window.GetHeight() * 0.70);
    prompt.sprite.SetOpacity(1);

    masked = "";
    for (i = 0; i < bullets; i++) { masked = masked + "*"; }
    masked = masked + "_";

    entry.image = Image.Text(masked, fg_r, fg_g, fg_b);
    entry.sprite.SetImage(entry.image);
    entry.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - entry.image.GetWidth() / 2);
    entry.sprite.SetY(Window.GetY() + Window.GetHeight() * 0.75);
    entry.sprite.SetOpacity(1);
}

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
}

// A no-op refresh keeps Plymouth happy on builds that expect one; the
// theme is static (Role A "immobile") so there is nothing to draw.
fun refresh_callback() {
}

fun quit_callback() {
    mark.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetQuitFunction(quit_callback);
